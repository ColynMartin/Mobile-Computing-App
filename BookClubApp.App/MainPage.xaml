<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:BookClubApp.App.Models"
    x:Class="BookClubApp.App.MainPage"
    Title="Book Club">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Page discussion"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Sample Book — Page 1"
                FontSize="18" />

            <Label Text="Local comments only. Sharing and sync will come later." />

            <Editor
                x:Name="CommentEditor"
                Placeholder="Write a comment about this page..."
                HeightRequest="120"
                AutoSize="TextChanges" />

            <Button
                x:Name="SaveButton"
                Text="Save comment"
                Clicked="OnSaveClicked" />

            <Button
                x:Name="ReloadButton"
                Text="Reload saved comments"
                Clicked="OnReloadClicked" />

            <Label
                x:Name="StatusLabel"
                Text="Loading comments..." />

            <VerticalStackLayout
                x:Name="CommentsLayout"
                Spacing="12">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:PageComment">
                        <Border Padding="12" StrokeThickness="1">
                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding AuthorName}"
                                    FontAttributes="Bold" />

                                <Label Text="{Binding CommentText}" />
                                <HorizontalStackLayout Spacing="12">
    <Button
        Text="Edit"
        Clicked="OnEditClicked" />

    <Button
        Text="Delete"
        Clicked="OnDeleteClicked" />
</HorizontalStackLayout>

                                <Label
                                    Text="{Binding CreatedAt,
                                        StringFormat='Saved (UTC): {0:yyyy-MM-dd HH:mm}'}"
                                    FontSize="12" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>